# Clave de la API de Anthropic (https://console.anthropic.com). Sin ella, el bot funciona en modo guiado sin IA.
ANTHROPIC_API_KEY=
# Opcional: modelo a usar (por defecto claude-haiku-4-5-20251001)
ANTHROPIC_MODEL=
# Opcional: URL que recibe el registro final como JSON (POST). Si no existe, el envío es simulado.
SUBMIT_WEBHOOK_URL=
SUBMIT_WEBHOOK_TOKEN=
# Opcional: enlaces de los consentimientos
POLICY_URL=
TERMS_URL=
