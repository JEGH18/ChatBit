# ─────────────────────────────────────────────────────────────
# Asistente Neo · variables de entorno
# Copie este archivo a .env.local (local) o configúrelas en Vercel (Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# ── IA (Claude, vía Vercel AI SDK) ──────────────────────────
# Sin clave, el asistente funciona en "modo guiado" (reglas, sin IA).
ANTHROPIC_API_KEY=
# Modelo principal: conversación y extracción de campos.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Modelo para clasificación (re-ordenar sugerencias CIIU): más barato y rápido.
ANTHROPIC_MODEL_CLASIFICACION=claude-haiku-5-5
# Esfuerzo del modelo: low (recomendado para chat) | medium | high.
ANTHROPIC_EFFORT=low
# Respaldo del lado de Anthropic si un clasificador de seguridad rechaza un turno ("off" para desactivar).
ANTHROPIC_FALLBACKS=default
# "auto" usa IA si hay clave; "guiado" la desactiva siempre (pruebas o demos sin internet).
ASISTENTE_MODO=auto

# ── Persistencia de sesiones (sin datos personales) y analítica ──
# sqlite (local, archivo prisma/dev.db) | postgres (Vercel Postgres / Neon) | memoria (sin base de datos).
# Si no se define: sqlite en local y memoria en Vercel.
DB_DRIVER=sqlite
DATABASE_URL="file:./prisma/dev.db"
# Para postgres, por ejemplo:
# DATABASE_URL="postgres://usuario:clave@host:5432/neo?sslmode=require"

# ── Panel administrativo (/admin) ────────────────────────────
# Cambie ambas antes de desplegar. ADMIN_SECRET firma la cookie de sesión.
ADMIN_PASSWORD=cambie-esta-clave
ADMIN_SECRET=una-cadena-larga-y-aleatoria-para-firmar-la-cookie

# ── Límites de uso en el servidor ────────────────────────────
# Peticiones al chat por IP y por minuto (generoso: muchas personas comparten IP).
LIMITE_IP_MINUTO=120

# ── Configuración visible en el navegador ────────────────────
# Trato por defecto: usted | tu
NEXT_PUBLIC_TRATAMIENTO=usted
# Si el formulario real permite "Prefiero no decir" en género.
NEXT_PUBLIC_GENERO_PREFIERO_NO_DECIR=true
# Datos de contacto del asesor (ficticios en el prototipo).
NEXT_PUBLIC_ASESOR_WHATSAPP=573000000000
NEXT_PUBLIC_ASESOR_TELEFONO=601 000 0000
NEXT_PUBLIC_ASESOR_HORARIO=lunes a viernes de 8:00 a. m. a 5:00 p. m.
# Textos completos de la política de datos y de los términos.
NEXT_PUBLIC_POLITICA_DATOS_URL=https://www.bancoldex.com/sites/default/files/politica_de_tratamiento_de_datos_personales_para_internet.pdf
NEXT_PUBLIC_TERMINOS_URL=https://neocredito.bancoldex.com/neocredito/home
# Máximo de mensajes de una persona por conversación.
NEXT_PUBLIC_MAX_MENSAJES_SESION=80
